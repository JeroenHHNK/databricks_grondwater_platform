{
  "datasets": [
    {
      "name": "t_per_leverancier",
      "displayName": "Test: reeksen per leverancier",
      "queryLines": [
        "SELECT coalesce(bronsysteem, 'onbekend') AS leverancier, count(*) AS reeksen\n",
        "FROM gold_prd.hl_grondwaterpeilmeting.meetreeks GROUP BY 1\n"
      ]
    },
    {
      "name": "t_per_dag",
      "displayName": "Test: metingen per dag (30 dagen)",
      "queryLines": [
        "SELECT to_date(m.tijdstempel_utc) AS datum, coalesce(r.bronsysteem, 'onbekend') AS leverancier,\n",
        "       count(*) AS metingen\n",
        "FROM gold_prd.hl_grondwaterpeilmeting.meting m JOIN gold_prd.hl_grondwaterpeilmeting.meetreeks r ON r.id = m.meetreeks_id\n",
        "WHERE m.tijdstempel_utc >= current_date() - INTERVAL 30 DAYS AND m.tijdstempel_utc < current_date()\n",
        "GROUP BY 1, 2\n"
      ]
    },
    {
      "name": "t_locaties",
      "displayName": "Test: grondwaterlocaties",
      "queryLines": [
        "SELECT code, naam, coalesce(meetreeks_actief, 'onbekend') AS meetreeks_actief,\n",
        "       CAST(wgs84_ycoordinaat AS double) AS lat, CAST(wgs84_xcoordinaat AS double) AS lon\n",
        "FROM gold_prd.hl_cs_objecten.meetlocatie\n",
        "WHERE compartiment_naam = 'Grondwater' AND wgs84_xcoordinaat IS NOT NULL\n"
      ]
    },
    {
      "name": "t_r2_klasse",
      "displayName": "Test: gevalideerde modellen per R2-klasse",
      "queryLines": [
        "SELECT model_type,\n",
        "       CASE WHEN NOT success OR r2 IS NULL THEN 'mislukt'\n",
        "            WHEN r2 >= 0.7 THEN 'R2 >= 0.7' ELSE 'R2 < 0.7' END AS klasse,\n",
        "       count(*) AS modellen\n",
        "FROM waterkeringbeheer_prd.jvanruitenbeek.valid_pastas_fit_metrics GROUP BY 1, 2\n"
      ]
    },
    {
      "name": "t_keuze",
      "displayName": "Test: keuzelijst reeksen",
      "queryLines": [
        "SELECT DISTINCT concat(coalesce(r.bronsysteem, '?'), ' | ', trim(r.code), ' [', substr(r.id, 1, 8), ']') AS reeks\n",
        "FROM gold_prd.hl_grondwaterpeilmeting.meetreeks r\n",
        "WHERE r.id IN (SELECT meetreeks_id FROM gold_prd.hl_grondwaterpeilmeting.meting WHERE tijdstempel_utc >= current_date() - INTERVAL 7 DAYS)\n",
        "ORDER BY reeks\n"
      ]
    },
    {
      "name": "t_reeks_dag",
      "displayName": "Test: daggemiddelde gekozen reeks (90 dagen)",
      "queryLines": [
        "SELECT to_date(m.tijdstempel_utc) AS datum, avg(m.waarde) AS waarde, 'sensor (ruw)' AS bron\n",
        "FROM gold_prd.hl_grondwaterpeilmeting.meting m JOIN gold_prd.hl_grondwaterpeilmeting.meetreeks r ON r.id = m.meetreeks_id\n",
        "WHERE concat(coalesce(r.bronsysteem, '?'), ' | ', trim(r.code), ' [', substr(r.id, 1, 8), ']') = :reeks\n",
        "  AND m.tijdstempel_utc >= current_date() - INTERVAL 90 DAYS\n",
        "GROUP BY 1\n"
      ],
      "parameters": [
        {
          "displayName": "reeks",
          "keyword": "reeks",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "t_reeks_info",
      "displayName": "Test: kenmerken gekozen reeks",
      "queryLines": [
        "SELECT r.code, r.bronsysteem, r.meetlocatie_code, r.begin_filter, r.eind_filter, r.bovenkant_peilbuis\n",
        "FROM gold_prd.hl_grondwaterpeilmeting.meetreeks r\n",
        "WHERE concat(coalesce(r.bronsysteem, '?'), ' | ', trim(r.code), ' [', substr(r.id, 1, 8), ']') = :reeks\n"
      ],
      "parameters": [
        {
          "displayName": "reeks",
          "keyword": "reeks",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ],
