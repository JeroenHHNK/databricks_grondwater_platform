__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Data and model outputs never go to git
*.csv
*.pas
!tests/data/*.csv
# Forcing is small and ships with the code: the cluster has no internet.
!data/forcing/*.csv

# Databricks / local config with secrets
.databricks/
.env
*.tfstate
.DS_Store

# Local output from scripts/check_knmi.py (not a cluster artefact)
.local/

# ... except what the Streamlit app reads from git: the results export
# (notebooks/analysis/export_results.py) and the family picks made in the app.
!results_export/**/*.csv
!family_choice/*.csv
