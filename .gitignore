# ---- Projectdata ----
# input_data/ IS versiebeheerd (inclusief .xlsx en .stix): de Databricks Git folder
# levert de invoer op de cluster, die geen internet en geen S-schijf heeft.
# Buiten input_data/ blijft alle Excel/stix ongewenst.
*.xlsx
*.xls
*.xlsm
*.stix
!input_data/**/*.xlsx
!input_data/**/*.stix

# Oude lokale meetexports (xlsx per project); vervangen door de Databricks-export.
input_data/*/peilbuisdata/

# Excel lock-/tijdelijke bestanden
~$*

# ---- Gegenereerde output ----
*.html
*.png
*.PNG
*.pdf
*.dxf

# SQLite / overige databases
*.db
*.sqlite
*.sqlite3
